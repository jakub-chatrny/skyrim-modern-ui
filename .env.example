# Copy to .env (git-ignored) and fill in. Read by scripts/*.sh.

# Skyrim SE game folder (the one containing SkyrimSE.exe).
# Steam library found on this machine at scaffold time:
#   /mnt/games/SteamLibrary/steamapps/common/Skyrim Special Edition
SKYRIM_FOLDER=""

# Where deploy.sh copies the mod. One of:
#  - a mod manager's folder for this mod, e.g. "$HOME/MO2/mods/SkyrimModernUI"
#  - empty: falls back to "$SKYRIM_FOLDER/Data"
# The layout written below it is:
#   SKSE/Plugins/SkyrimModernUI.dll
#   PrismaUI/views/SkyrimModernUI/index.html (+ assets)
DEPLOY_DIR=""

# Proton prefix of the game, for reading SKSE logs. Leave empty to derive it
# from SKYRIM_FOLDER (<library>/steamapps/compatdata/489830/pfx).
SKYRIM_PREFIX=""
