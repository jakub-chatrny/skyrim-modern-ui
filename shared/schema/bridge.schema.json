{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skyrim-modern-ui/bridge.schema.json",
  "title": "Skyrim Modern UI bridge",
  "description": "Single source of truth for messages between the SKSE plugin and the web UI. Plugin -> UI: Snapshot (JSON string passed to window.smuiReceive) and ItemList (window.smuiItems, the answer to a listItems command). UI -> plugin: Command (JSON string passed to window.smuiCommand). Keep ui/src/bridge/types.ts in sync by hand.",
  "oneOf": [
    {
      "$ref": "#/$defs/Snapshot"
    },
    {
      "$ref": "#/$defs/ItemList"
    },
    {
      "$ref": "#/$defs/Command"
    }
  ],
  "$defs": {
    "Snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "player",
        "vitals",
        "resistances",
        "damage",
        "skills",
        "equipment",
        "outfits",
        "picturesPending"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "player": {
          "$ref": "#/$defs/Player"
        },
        "vitals": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "health",
            "stamina",
            "magicka"
          ],
          "properties": {
            "health": {
              "$ref": "#/$defs/Gauge"
            },
            "stamina": {
              "$ref": "#/$defs/Gauge"
            },
            "magicka": {
              "$ref": "#/$defs/Gauge"
            }
          }
        },
        "survival": {
          "description": "Only present when Survival Mode or a needs mod is active.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "energy": {
              "$ref": "#/$defs/Gauge"
            },
            "hunger": {
              "$ref": "#/$defs/Gauge"
            },
            "thirst": {
              "$ref": "#/$defs/Gauge"
            },
            "warmth": {
              "$ref": "#/$defs/Gauge"
            }
          }
        },
        "resistances": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "armor",
            "magic",
            "fire",
            "frost",
            "shock",
            "poison",
            "disease"
          ],
          "properties": {
            "armor": {
              "type": "number"
            },
            "magic": {
              "type": "number"
            },
            "fire": {
              "type": "number"
            },
            "frost": {
              "type": "number"
            },
            "shock": {
              "type": "number"
            },
            "poison": {
              "type": "number"
            },
            "disease": {
              "type": "number"
            }
          }
        },
        "damage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rightHand",
            "leftHand",
            "ranged",
            "meleeSpeed",
            "rangedSpeed",
            "magicPower"
          ],
          "properties": {
            "rightHand": {
              "type": "number"
            },
            "leftHand": {
              "type": "number"
            },
            "ranged": {
              "type": "number"
            },
            "meleeSpeed": {
              "type": "number"
            },
            "rangedSpeed": {
              "type": "number"
            },
            "magicPower": {
              "type": "number"
            }
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "level"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Actor value name, e.g. OneHanded"
              },
              "name": {
                "type": "string"
              },
              "level": {
                "type": "integer"
              },
              "progress": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "equipment": {
          "description": "One entry per slot; null when the slot is empty.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "head",
            "body",
            "hands",
            "feet",
            "leftHand",
            "rightHand",
            "mask",
            "cloak",
            "neck",
            "ring",
            "ranged",
            "ammo"
          ],
          "properties": {
            "head": {
              "$ref": "#/$defs/SlotItem"
            },
            "body": {
              "$ref": "#/$defs/SlotItem"
            },
            "hands": {
              "$ref": "#/$defs/SlotItem"
            },
            "feet": {
              "$ref": "#/$defs/SlotItem"
            },
            "leftHand": {
              "$ref": "#/$defs/SlotItem"
            },
            "rightHand": {
              "$ref": "#/$defs/SlotItem"
            },
            "mask": {
              "$ref": "#/$defs/SlotItem"
            },
            "cloak": {
              "$ref": "#/$defs/SlotItem"
            },
            "neck": {
              "$ref": "#/$defs/SlotItem"
            },
            "ring": {
              "$ref": "#/$defs/SlotItem"
            },
            "ranged": {
              "$ref": "#/$defs/SlotItem"
            },
            "ammo": {
              "$ref": "#/$defs/SlotItem"
            }
          }
        },
        "outfits": {
          "$ref": "#/$defs/Outfits"
        },
        "picturesPending": {
          "type": "integer",
          "minimum": 0,
          "description": "Item pictures still being made. While above 0 the character is replaced on screen by the items being pictured."
        },
        "effects": {
          "type": "array",
          "description": "Active effects, one per spell, potion or food; hidden and inactive effects left out.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "description",
              "remaining",
              "positive",
              "kind"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "remaining": {
                "type": "number",
                "description": "Seconds left; -1 when the effect does not run out."
              },
              "positive": {
                "type": "boolean"
              },
              "kind": {
                "enum": [
                  "cold",
                  "food",
                  "other"
                ]
              },
              "source": {
                "type": "string",
                "description": "Spell type: spell, ability, disease, power, lesserPower, poison, enchantment, potion, ingredient, shout, addiction, other."
              },
              "racial": {
                "type": "boolean",
                "description": "Granted by the player's race."
              },
              "av": {
                "type": "string",
                "description": "Actor value the effect changes (OneHanded, ResistFire, ...); empty for none."
              },
              "archetype": {
                "type": "string",
                "description": "Effect archetype (ValueModifier, Cloak, Paralysis, ...)."
              },
              "school": {
                "type": "string",
                "description": "Magic skill of the effect (Alteration, ...); empty for none."
              }
            }
          }
        },
        "dropping": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Form ids of items queued to be dropped when the screen closes, one entry per copy."
        },
        "toggleKey": {
          "type": "string",
          "description": "The key that opens and closes the screen, as named in the settings (\"Tab\", \"F4\", ...)."
        }
      }
    },
    "Player": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "level",
        "xpProgress",
        "gold",
        "carryWeight",
        "dragonSouls"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "level": {
          "type": "integer"
        },
        "xpProgress": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "gold": {
          "type": "integer"
        },
        "carryWeight": {
          "$ref": "#/$defs/Gauge"
        },
        "dragonSouls": {
          "type": "integer"
        }
      }
    },
    "Gauge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current",
        "max"
      ],
      "properties": {
        "current": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    },
    "SlotItem": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "formId",
            "name",
            "type",
            "icon",
            "stats"
          ],
          "properties": {
            "formId": {
              "type": "string",
              "pattern": "^0x[0-9A-F]{8}$"
            },
            "name": {
              "type": "string"
            },
            "type": {
              "enum": [
                "armor",
                "clothing",
                "jewelry",
                "weapon",
                "shield",
                "spell",
                "ammo",
                "torch"
              ]
            },
            "icon": {
              "type": "string",
              "description": "Icon key; generic per-type icons first, per-item later."
            },
            "stats": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "label",
                  "value"
                ],
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  }
                }
              }
            },
            "thumb": {
              "type": [
                "string",
                "null"
              ],
              "description": "URL of the item's cached picture, or null while there is none. Made in game by plugin/src/Thumbnails.cpp."
            },
            "enchantment": {
              "type": [
                "string",
                "null"
              ],
              "description": "What the item's enchantment does, as the inventory describes it; null when it has none."
            }
          }
        }
      ]
    },
    "Command": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "ready",
                "close"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "formId"
          ],
          "properties": {
            "type": {
              "const": "equip"
            },
            "formId": {
              "type": "string"
            },
            "slot": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "slot"
          ],
          "properties": {
            "type": {
              "const": "unequip"
            },
            "slot": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "index"
          ],
          "properties": {
            "type": {
              "const": "switchOutfit"
            },
            "index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "slot"
          ],
          "properties": {
            "type": {
              "const": "listItems"
            },
            "slot": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "formId"
          ],
          "properties": {
            "type": {
              "enum": [
                "drop",
                "favorite",
                "use"
              ],
              "description": "drop: one of the item onto the ground; favorite: toggle its favourite mark; use: the Inventory tab's Enter (worn gear comes off, other gear goes on, potions, food and ingredients are consumed)."
            },
            "formId": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "listInventory",
              "description": "Ask for everything the player carries; answered with window.smuiInventory(Inventory)."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "open"
          ],
          "properties": {
            "type": {
              "const": "preview",
              "description": "The Inventory tab: open hides the character; formId is shown in 3D in rect (fractions of the window)."
            },
            "open": {
              "type": "boolean"
            },
            "formId": {
              "type": [
                "string",
                "null"
              ]
            },
            "rect": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "left",
                "top",
                "width",
                "height"
              ],
              "properties": {
                "left": {
                  "type": "number"
                },
                "top": {
                  "type": "number"
                },
                "width": {
                  "type": "number"
                },
                "height": {
                  "type": "number"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "degrees"
          ],
          "properties": {
            "type": {
              "const": "turn",
              "description": "Turn the Inventory tab's 3D preview, degrees."
            },
            "degrees": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "degrees"
          ],
          "properties": {
            "type": {
              "const": "turnCharacter",
              "description": "Turn the character in place on the Character tab, degrees; the camera stays."
            },
            "degrees": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "listQuests",
              "description": "Answered with window.smuiQuests(QuestLog)."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "questId"
          ],
          "properties": {
            "type": {
              "const": "trackQuest",
              "description": "Track or untrack a quest on the compass."
            },
            "questId": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "showMap",
              "description": "Close the screen and open the game's map."
            }
          }
        }
      ]
    },
    "Outfits": {
      "description": "Four equipment sets; the active one is whatever is worn now.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active",
        "defined",
        "missing"
      ],
      "properties": {
        "active": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "defined": {
          "type": "array",
          "items": {
            "type": "boolean"
          },
          "minItems": 4,
          "maxItems": 4,
          "description": "False for an outfit that was never used; switching to it keeps the current gear."
        },
        "missing": {
          "type": "integer",
          "minimum": 0,
          "description": "Items the last switch wanted but the player no longer had."
        }
      }
    },
    "InventoryItem": {
      "description": "A SlotItem plus how many the player has and whether it is the one in the slot.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formId",
        "name",
        "type",
        "icon",
        "stats",
        "count",
        "equipped"
      ],
      "properties": {
        "formId": {
          "type": "string",
          "pattern": "^0x[0-9A-F]{8}$"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "enum": [
            "armor",
            "clothing",
            "jewelry",
            "weapon",
            "shield",
            "spell",
            "ammo",
            "torch"
          ]
        },
        "icon": {
          "type": "string",
          "description": "Icon key; generic per-type icons first, per-item later."
        },
        "stats": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "value"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          }
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "equipped": {
          "type": "boolean"
        },
        "thumb": {
          "type": [
            "string",
            "null"
          ],
          "description": "URL of the item's cached picture, or null while there is none. Made in game by plugin/src/Thumbnails.cpp."
        },
        "enchantment": {
          "type": [
            "string",
            "null"
          ],
          "description": "What the item's enchantment does, as the inventory describes it; null when it has none."
        },
        "favorite": {
          "type": "boolean",
          "description": "Marked as a favourite in the game's inventory."
        }
      }
    },
    "ItemList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "items"
      ],
      "properties": {
        "slot": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InventoryItem"
          }
        }
      }
    },
    "InventoryEntry": {
      "description": "One kind of item the player carries, for the Inventory tab.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formId",
        "name",
        "category",
        "typeLabel",
        "count",
        "worn",
        "favorite",
        "stats",
        "enchantments",
        "rarity",
        "description",
        "thumb"
      ],
      "properties": {
        "formId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "category": {
          "enum": [
            "weapons",
            "armor",
            "potions",
            "food",
            "ingredients",
            "books",
            "misc"
          ]
        },
        "typeLabel": {
          "type": "string",
          "description": "\"Heavy Armor · Body\", \"One-handed · Sword\", \"Potion\", ..."
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "worn": {
          "type": "boolean"
        },
        "favorite": {
          "type": "boolean"
        },
        "stats": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "weight",
            "value"
          ],
          "properties": {
            "damage": {
              "type": "number"
            },
            "armor": {
              "type": "number"
            },
            "weight": {
              "type": "number"
            },
            "value": {
              "type": "integer"
            }
          }
        },
        "enchantments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "element"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "element": {
                "enum": [
                  "frost",
                  "fire",
                  "shock",
                  "holy"
                ]
              }
            }
          }
        },
        "rarity": {
          "enum": [
            "common",
            "rare",
            "epic",
            "legendary"
          ],
          "description": "Not a game value: one enchantment rare, two epic; unique items and Daedric artifacts legendary."
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "thumb": {
          "type": [
            "string",
            "null"
          ]
        },
        "facts": {
          "type": "array",
          "description": "Label / value rows: skill, speed, reach, what a book teaches or raises, a soul gem's capacity and soul, quest item, stolen.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "value"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "Inventory": {
      "description": "The plugin's answer to listInventory.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InventoryEntry"
          }
        }
      }
    },
    "QuestTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "place": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "metres": {
          "type": "number",
          "description": "From the player, when both are in the same world or cell."
        },
        "direction": {
          "type": "string",
          "description": "North, North-east, ..."
        }
      }
    },
    "QuestObjective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "state"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "state": {
          "enum": [
            "active",
            "completed",
            "failed"
          ]
        },
        "target": {
          "$ref": "#/$defs/QuestTarget"
        }
      }
    },
    "Quest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type",
        "tracked",
        "completed",
        "objectives",
        "journal"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "enum": [
            "main",
            "companions",
            "college",
            "thieves",
            "darkBrotherhood",
            "civilWar",
            "dawnguard",
            "dragonborn",
            "daedric",
            "side",
            "misc"
          ]
        },
        "tracked": {
          "type": "boolean",
          "description": "Shown on the compass (TESQuest::IsActive)."
        },
        "completed": {
          "type": "boolean"
        },
        "objectives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QuestObjective"
          },
          "description": "Active first, newest first."
        },
        "journal": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Journal entries, newest first."
        }
      }
    },
    "QuestLog": {
      "description": "The plugin's answer to listQuests.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quests"
      ],
      "properties": {
        "quests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Quest"
          }
        }
      }
    }
  }
}
